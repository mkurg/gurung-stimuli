      <CodeComponent name="flow_2" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="import * as _os from '_os';&amp;#10;import * as _glob from '_glob';&amp;#10;import * as _time from '_time';&amp;#10;import {core} from 'psychopy';&amp;#10;import {event as kbEvent} from 'psychopy';&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="stage = 0;&amp;#10;pic1.opacity = 1;&amp;#10;pic2.opacity = 1;&amp;#10;pic3.opacity = 1;&amp;#10;mask1.opacity = 1;&amp;#10;mask2.opacity = 1;&amp;#10;mask3.opacity = 1;&amp;#10;isPractice = (Number.parseInt(showArrows) === 1);&amp;#10;arrow12.opacity = (isPractice ? 1 : 0);&amp;#10;arrow23.opacity = (isPractice ? 1 : 0);&amp;#10;hideEarlierPics = true;&amp;#10;if ((isPractice &amp;&amp; (PracticeLoop.thisN &lt; 3))) {&amp;#10;    hideEarlierPics = false;&amp;#10;}&amp;#10;audioStarted = false;&amp;#10;audioClock = new util.Clock();&amp;#10;audioDur = snd.getDuration();&amp;#10;lastPressTime = (- 999);&amp;#10;debounceSec = 0.2;&amp;#10;if (isPractice) {&amp;#10;    trialLabel = `prac${(PracticeLoop.thisN + 1)}`;&amp;#10;} else {&amp;#10;    trialLabel = `main${(TrialLoop.thisN + 1)}`;&amp;#10;}&amp;#10;baseName = `${trialLabel}_set${setID.toString()}_cond${cond.toString()}`;&amp;#10;recNum = 1;&amp;#10;isRecording = false;&amp;#10;function mic_start(filename) {&amp;#10;    /* Start mic recording (handles common PsychoPy mic APIs). */&amp;#10;    if ((&quot;record&quot; in mic)) {&amp;#10;        try {&amp;#10;            mic.record(filename);&amp;#10;            return;&amp;#10;        } catch(e) {&amp;#10;            if ((e instanceof TypeError)) {&amp;#10;                mic.filename = filename;&amp;#10;                mic.record();&amp;#10;                return;&amp;#10;            } else {&amp;#10;                throw e;&amp;#10;            }&amp;#10;        }&amp;#10;    }&amp;#10;    if ((&quot;start&quot; in mic)) {&amp;#10;        try {&amp;#10;            mic.start({&quot;filename&quot;: filename});&amp;#10;        } catch(e) {&amp;#10;            if ((e instanceof TypeError)) {&amp;#10;                mic.start();&amp;#10;            } else {&amp;#10;                throw e;&amp;#10;            }&amp;#10;        }&amp;#10;        return;&amp;#10;    }&amp;#10;    throw new RuntimeError(&quot;Microphone API not recognized in this PsychoPy version.&quot;);&amp;#10;}&amp;#10;function mic_stop() {&amp;#10;    /* Stop mic recording (handles common PsychoPy mic APIs). */&amp;#10;    if ((&quot;stop&quot; in mic)) {&amp;#10;        mic.stop();&amp;#10;        return;&amp;#10;    }&amp;#10;    if ((&quot;stopRecording&quot; in mic)) {&amp;#10;        mic.stopRecording();&amp;#10;        return;&amp;#10;    }&amp;#10;}&amp;#10;kbEvent.clearEvents();&amp;#10;recFile = `recordings/${baseName}_rec${recNum}`;&amp;#10;mic_start(recFile);&amp;#10;isRecording = true;&amp;#10;isPractice = (Number.parseInt(showArrows) === 1);&amp;#10;if (isPractice) {&amp;#10;    trialLabel = `prac${(PracticeLoop.thisN + 1)}`;&amp;#10;} else {&amp;#10;    trialLabel = `main${(TrialLoop.thisN + 1)}`;&amp;#10;}&amp;#10;baseName = `${trialLabel}_set${setID}_cond${cond}`;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="isPractice = bool(showArrows)&amp;#10;&amp;#10;pic1_2.opacity = 1&amp;#10;pic2_2.opacity = 1&amp;#10;pic3_2.opacity = 1&amp;#10;&amp;#10;# pic1 and pic2 revealed&amp;#10;mask1_2.opacity = 0&amp;#10;mask2_2.opacity = 0&amp;#10;&amp;#10;# pic3 still hidden&amp;#10;mask3_2.opacity = 1&amp;#10;&amp;#10;arrow12_2.opacity = 1 if isPractice else 0&amp;#10;arrow23_2.opacity = 1 if isPractice else 0" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="keys = kbEvent.getKeys([&quot;space&quot;]);&amp;#10;if ((keys &amp;&amp; ((t - lastPressTime) &gt; debounceSec))) {&amp;#10;    lastPressTime = t;&amp;#10;    if ((stage === 0)) {&amp;#10;        mask1.opacity = 0;&amp;#10;        if (isRecording) {&amp;#10;            mic_stop();&amp;#10;            isRecording = false;&amp;#10;        }&amp;#10;        recNum = 2;&amp;#10;        recFile = `recordings/${baseName}_rec${recNum}`;&amp;#10;        mic_start(recFile);&amp;#10;        isRecording = true;&amp;#10;        stage = 1;&amp;#10;    } else {&amp;#10;        if ((stage === 1)) {&amp;#10;            mask2.opacity = 0;&amp;#10;            if (isRecording) {&amp;#10;                mic_stop();&amp;#10;                isRecording = false;&amp;#10;            }&amp;#10;            recNum = 3;&amp;#10;            recFile = `recordings/${baseName}_rec${recNum}`;&amp;#10;            mic_start(recFile);&amp;#10;            isRecording = true;&amp;#10;            stage = 2;&amp;#10;        } else {&amp;#10;            if ((stage === 2)) {&amp;#10;                if (isRecording) {&amp;#10;                    mic_stop();&amp;#10;                    isRecording = false;&amp;#10;                }&amp;#10;                if (isPractice) {&amp;#10;                    snd.stop();&amp;#10;                    snd.play();&amp;#10;                    audioStarted = true;&amp;#10;                    audioClock.reset();&amp;#10;                    stage = 3;&amp;#10;                } else {&amp;#10;                    pic1.opacity = 0;&amp;#10;                    pic2.opacity = 0;&amp;#10;                    mask1.opacity = 1;&amp;#10;                    mask2.opacity = 1;&amp;#10;                    mask3.opacity = 0;&amp;#10;                    stage = 4;&amp;#10;                }&amp;#10;            } else {&amp;#10;                if ((stage === 4)) {&amp;#10;                    continueRoutine = false;&amp;#10;                }&amp;#10;            }&amp;#10;        }&amp;#10;    }&amp;#10;}&amp;#10;if (((stage === 3) &amp;&amp; audioStarted)) {&amp;#10;    if ((audioClock.getTime() &gt;= audioDur)) {&amp;#10;        if (hideEarlierPics) {&amp;#10;            pic1.opacity = 0;&amp;#10;            pic2.opacity = 0;&amp;#10;            mask1.opacity = 1;&amp;#10;            mask2.opacity = 1;&amp;#10;        }&amp;#10;        mask3.opacity = 0;&amp;#10;        stage = 4;&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
