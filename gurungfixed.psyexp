      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[OrderedDict([('img1', 'Stimuli/pr1_1.png'), ('img2', 'Stimuli/pr1_2.png'), ('img3', 'Stimuli/pr1_3.png'), ('cond', np.int64(0)), ('showArrows', np.int64(1)), ('setID', np.int64(0))]), OrderedDict([('img1', 'Stimuli/pr2_1.png'), ('img2', 'Stimuli/pr2_2.png'), ('img3', 'Stimuli/pr2_3.png'), ('cond', np.int64(0)), ('showArrows', np.int64(1)), ('setID', np.int64(0))]), OrderedDict([('img1', 'Stimuli/pr3_1.png'), ('img2', 'Stimuli/pr3_2.png'), ('img3', 'Stimuli/pr3_3.png'), ('cond', np.int64(0)), ('showArrows', np.int64(1)), ('setID', np.int64(0))]), OrderedDict([('img1', 'Stimuli/pr4_1.png'), ('img2', 'Stimuli/pr4_2.png'), ('img3', 'Stimuli/pr4_3.png'), ('cond', np.int64(0)), ('showArrows', np.int64(1)), ('setID', np.int64(0))]), OrderedDict([('img1', 'Stimuli/pr5_1.png'), ('img2', 'Stimuli/pr5_2.png'), ('img3', 'Stimuli/pr5_3.png'), ('cond', np.int64(0)), ('showArrows', np.int64(1)), ('setID', np.int64(0))]), OrderedDict([('img1', 'Stimuli/pr6_1.png'), ('img2', 'Stimuli/pr6_2.png'), ('img3', 'Stimuli/pr6_3.png'), ('cond', np.int64(0)), ('showArrows', np.int64(1)), ('setID', np.int64(0))]), OrderedDict([('img1', 'Stimuli/pr7_1.png'), ('img2', 'Stimuli/pr7_2.png'), ('img3', 'Stimuli/pr7_3.png'), ('cond', np.int64(0)), ('showArrows', np.int64(1)), ('setID', np.int64(0))]), OrderedDict([('img1', 'Stimuli/pr8_1.png'), ('img2', 'Stimuli/pr8_2.png'), ('img3', 'Stimuli/pr8_3.png'), ('cond', np.int64(0)), ('showArrows', np.int64(1)), ('setID', np.int64(0))])]" valType="str"/>
