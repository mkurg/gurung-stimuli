        <Param name="Begin Routine" val="&#10;win.color = &quot;white&quot;&#10;break_image = visual.ImageStim(win, image=g_path(&quot;Stimuli/break.png&quot;), pos=(0, 0), size=(0.55, 0.55), interpolate=True)&#10;break_clock = core.Clock()&#10;event.clearEvents()&#10;" valType="extendedCode" updates="constant" />
