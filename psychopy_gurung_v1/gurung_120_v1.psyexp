        <Param name="End Routine" val="&#10;G_RECORDER.stop()&#10;if practice_audio:&#10;    practice_audio.stop()&#10;g_release_stims(practice_images, practice_arrows)&#10;g_release_fullscreen_image(practice_placeholder)&#10;practice_images = []&#10;practice_arrows = []&#10;practice_placeholder = None&#10;" valType="extendedCode" updates="constant" />
