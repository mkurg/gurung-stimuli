{
  "10:draft:end_coh_it": {
    "text": "\u043f\u0435\u0440\u0435\u043f\u0440\u044b\u0433\u043d\u0443\u043b \u0447\u0435\u0440\u0435\u0437 \u0434\u0435\u0432\u043e\u0447\u043a\u0438\u043d\u043e \u0431\u043b\u044e\u0434\u043e",
    "updatedAt": "2026-06-02T21:17:42"
  },
  "1:draft:end_ic_it": {
    "text": "\u0432\u043e\u0434\u0438\u0447\u043a\u0443 \u043a\u0442\u043e-\u0442\u043e \u0435\u043c\u0443 \u0434\u0430\u0451\u0442?",
    "updatedAt": "2026-06-02T18:59:30"
  },
  "20:draft:end_ic_it": {
    "text": "\u043f\u043e\u043a\u0443\u043f\u0430\u0435\u0442 \u0432 \u043b\u0430\u0440\u044c\u043a\u0435 \u043f\u0435\u0447\u0435\u043d\u044c\u043a\u0438",
    "updatedAt": "2026-06-02T21:47:21"
  },
  "25:draft:end_ic_it": {
    "text": "\u0438\u0434\u0451\u0442 \u0441\u043e\u0431\u0438\u0440\u0430\u0442\u044c \u043c\u0451\u0434",
    "updatedAt": "2026-06-02T21:46:37"
  },
  "2:draft:end_ic_it": {
    "text": "\u043f\u0440\u0438\u0432\u043e\u0434\u0438\u0442 \u0440\u0435\u0431\u0451\u043d\u043a\u0430 \u0432 daycare, \u0442\u0430\u043c \u0434\u0440\u0443\u0433\u0438\u0435 \u0434\u0435\u0442\u0438 \u0435\u0449\u0451 \u0442\u043e\u0436\u0435",
    "updatedAt": "2026-06-02T21:37:30"
  },
  "3:draft:end_ic_it": {
    "text": "\u0434\u0435\u0442\u0438 \u043f\u044b\u0442\u0430\u044e\u0442\u0441\u044f \u0441 \u043d\u0435\u0439 \u043d\u0430\u0447\u0430\u0442\u044c \u0438\u0433\u0440\u0430\u0442\u044c? \u043d\u0435\u0442, \u0441\u043e\u0431\u0430\u043a\u0430 \u043e\u0442\u0440\u044f\u0445\u0438\u0432\u0430\u0435\u0442\u0441\u044f",
    "updatedAt": "2026-06-02T20:53:44"
  },
  "4:draft:end_ic_tr": {
    "text": "\u043a\u0443\u0437\u043d\u0435\u0447\u0438\u043a \u043f\u0440\u044b\u0433\u0430\u0435\u0442 \u043d\u0430 \u043d\u0435\u0451 \u0438 \u043e\u043d\u0430 \u043f\u0440\u043e\u043b\u0438\u0432\u0430\u0435\u0442 \u0447\u0430\u0439",
    "updatedAt": "2026-06-02T21:22:01"
  },
  "6:draft:end_coh_it": {
    "text": "\u043e\u043d \u043f\u043e\u043b\u044c\u0451\u0442 \u0435\u0451",
    "updatedAt": "2026-06-02T20:59:06"
  },
  "6:draft:end_ic_it": {
    "text": "\u0440\u0435\u0431\u0451\u043d\u043e\u043a \u0441 \u0434\u0435\u0440\u0435\u0432\u0430 \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0435\u0442 \u043d\u0430 \u043d\u0435\u0451 \u0441\u0430\u043c\u043e\u043b\u0451\u0442\u0438\u043a",
    "updatedAt": "2026-06-02T21:03:30"
  },
  "7:draft:end_ic_tr": {
    "text": "\u0441 \u0443\u043b\u0438\u0446\u044b \u043a\u0442\u043e-\u0442\u043e \u043f\u0440\u0438\u0448\u0451\u043b \u0433\u0440\u0435\u0442\u044c\u0441\u044f \u043c\u043e\u043a\u0440\u044b\u0439",
    "updatedAt": "2026-06-02T21:05:08"
  },
  "8:draft:end_coh_it": {
    "text": "\u043d\u0435 \u0437\u043d\u0430\u044e, \u0431\u0430\u0431\u043a\u0430 \u043f\u043b\u0435\u0442\u0451\u0442 \u0430 \u0434\u0435\u0432\u043e\u0447\u043a\u0430 \u0441\u043c\u043e\u0442\u0440\u0438\u0442?",
    "updatedAt": "2026-06-02T19:05:53"
  },
  "8:draft:end_ic_tr": {
    "text": "\u043f\u0440\u043e\u0432\u043e\u0436\u0430\u0435\u0442 \u0431\u0435\u043b\u044b\u0445 \u0442\u0443\u0440\u0438\u0441\u0442\u043e\u0432, \u043d\u0430\u0434\u0435\u0432\u0430\u0435\u0442 \u043d\u0430 \u043a\u043e\u0433\u043e-\u0442\u043e, \u0430 \u043a\u0442\u043e-\u0442\u043e \u0444\u043e\u0442\u043a\u0430\u0435\u0442 \u0440\u0430\u0434\u0443\u0433\u0443 \u0438\u0437 \u044d\u0442\u0438\u0445 \u0442\u0443\u0440\u0438\u0441\u0442\u043e\u0432. \u043e\u043d\u0438 \u0442\u0440\u0435\u043a\u0435\u0440\u044b",
    "updatedAt": "2026-06-02T21:09:26"
  },
  "9:draft:end_ic_it": {
    "text": "\u043f\u0440\u0438\u0448\u043b\u0430 \u043a \u0432\u043e\u0434\u043e\u043f\u0430\u0434\u0443",
    "updatedAt": "2026-06-02T21:15:42"
  },
  "9:draft:end_ic_tr": {
    "text": "\u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044f \u0447\u0435\u0440\u0435\u0437 \u0430\u0440\u043a\u0443 thank you visit again (\u0413\u043e\u043d\u044f \u0441\u043a\u0438\u043d\u0435\u0442)",
    "updatedAt": "2026-06-02T21:38:33"
  }
}
