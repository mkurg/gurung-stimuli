{
  "1:draft:end_ic_it": {
    "text": "\u0432\u043e\u0434\u0438\u0447\u043a\u0443 \u043a\u0442\u043e-\u0442\u043e \u0435\u043c\u0443 \u0434\u0430\u0451\u0442?",
    "updatedAt": "2026-06-02T18:59:30"
  },
  "20:draft:end_ic_it": {
    "text": "\u0436\u0430\u0440\u043a\u043e, \u043d\u044b\u0440\u044f\u0435\u0442 \u0432 \u0440\u0435\u043a\u0443",
    "updatedAt": "2026-06-02T18:42:05"
  },
  "2:draft:end_ic_it": {
    "text": "\u043a\u0442\u043e-\u0442\u043e \u043f\u0440\u043e\u0435\u0437\u0436\u0430\u0435\u0442 \u043c\u0438\u043c\u043e, \u0447\u0443\u0442\u044c \u043d\u0435 \u0441\u0431\u0438\u0432\u0430\u0435\u0442 \u0435\u0433\u043e?",
    "updatedAt": "2026-06-02T19:01:15"
  },
  "3:draft:end_ic_it": {
    "text": "\u0434\u0435\u0442\u0438 \u043f\u044b\u0442\u0430\u044e\u0442\u0441\u044f \u0441 \u043d\u0435\u0439 \u043d\u0430\u0447\u0430\u0442\u044c \u0438\u0433\u0440\u0430\u0442\u044c?",
    "updatedAt": "2026-06-02T19:02:45"
  },
  "6:draft:end_coh_it": {
    "text": "\u043c\u0443\u0436\u0438\u043a \u043f\u0440\u0438\u043d\u0451\u0441 \u043f\u043e\u043c\u0438\u0434\u043e\u0440 \u0441\u0430\u0436\u0430\u0442\u044c \u0430 \u043e\u043d\u0430 \u043d\u0430 \u044d\u0442\u043e\u043c \u043c\u0435\u0441\u0442\u0435 \u0441\u043f\u0438\u0442",
    "updatedAt": "2026-06-02T19:04:06"
  },
  "6:draft:end_ic_it": {
    "text": "\u0435\u0451 \u0435\u0431\u0443\u0442",
    "updatedAt": "2026-06-02T19:04:15"
  },
  "7:draft:end_ic_tr": {
    "text": "\u043f\u0440\u0438\u043d\u0435\u0441\u043b\u0430 \u0435\u0449\u0451 \u0434\u0440\u043e\u0432, \u0440\u044f\u0434\u043e\u043c \u043f\u043e\u043b\u043e\u0436\u0438\u043b\u0430?",
    "updatedAt": "2026-06-02T19:04:51"
  },
  "8:draft:end_coh_it": {
    "text": "\u043d\u0435 \u0437\u043d\u0430\u044e, \u0431\u0430\u0431\u043a\u0430 \u043f\u043b\u0435\u0442\u0451\u0442 \u0430 \u0434\u0435\u0432\u043e\u0447\u043a\u0430 \u0441\u043c\u043e\u0442\u0440\u0438\u0442?",
    "updatedAt": "2026-06-02T19:05:53"
  },
  "9:draft:end_ic_it": {
    "text": "\u0441\u0435\u043b\u0430 \u043d\u0430 \u043b\u0435\u0441\u0442\u043d\u0438\u0446\u0443 \u0441\u043c\u043e\u0442\u0440\u0438\u0442 \u043d\u0430 \u043a\u0440\u0430\u0441\u0438\u0432\u044b\u0439 \u043f\u0435\u0439\u0437\u0430\u0436?",
    "updatedAt": "2026-06-02T19:07:47"
  },
  "9:draft:end_ic_tr": {
    "text": "\u043d\u0435\u0441\u0451\u0442 / \u0432\u0435\u0437\u0451\u0442 \u0434\u043e\u043c\u043e\u0439 \u0440\u0438\u0441, \u043f\u043e\u0433\u0443\u0433\u043b\u0438\u0442\u044c \u043a\u0430\u043a \u043e\u043d\u0438 \u044d\u0442\u043e \u0434\u0435\u043b\u0430\u044e\u0442",
    "updatedAt": "2026-06-02T19:07:27"
  }
}
