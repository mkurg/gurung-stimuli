    <Param val="{'participant': 'f&quot;{randint(0, 999999):06.0f}&quot;', 'session': '001', 'list': '1', 'eeg_port': '', 'trigger_pulse_ms': '5'}" valType="code" updates="None" name="Experiment info" />
