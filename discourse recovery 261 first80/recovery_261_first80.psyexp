        <Param name="Begin Routine" val="
from pathlib import Path
import importlib.util
import sys

module_path = Path(_thisDir) / &quot;recovery_261_first80.py&quot;
spec = importlib.util.spec_from_file_location(&quot;recovery_261_first80_module&quot;, str(module_path))
recovery_module = importlib.util.module_from_spec(spec)
sys.modules[&quot;recovery_261_first80_module&quot;] = recovery_module
spec.loader.exec_module(recovery_module)
recovery_module.run_from_builder(win, expInfo)
continueRoutine = False
